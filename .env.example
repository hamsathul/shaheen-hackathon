# Local OpenAI-compatible model endpoint for the investigator.
# Leave both empty to run Baaz without the investigator: scan, batch and watch need no model.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=local
# Set to off when the endpoint has no tool calling: the investigator then answers in one shot.
LLM_TOOL_CALLING=on
# The investigator's browser (Playwright MCP). Empty: the global npm install, else npx.
BAAZ_BROWSER_MCP=
# 1 lets the investigator's browser reach localhost and private addresses (local fixture demos only).
BAAZ_ALLOW_PRIVATE_FETCH=0

# Storage
BAAZ_DB=var/baaz.db
BAAZ_EVIDENCE_DIR=evidence

# Network
BAAZ_HTTP_TIMEOUT=10

# Takedown requests: who signs them (generated only for analyst-confirmed cases)
BAAZ_REPORTER_NAME=Baaz analyst
BAAZ_REPORTER_EMAIL=

# Watcher: TLDs swept for brand+country storefront names, in order (.com first)
BAAZ_STOREFRONT_TLDS=com,shop,store,online,net,co
