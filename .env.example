# Local OpenAI-compatible model endpoint for the investigator.
# Leave both empty to run Shaheen without the investigator: scan, batch and watch need no model.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=local
# Set to off when the endpoint has no tool calling: the investigator then answers in one shot.
LLM_TOOL_CALLING=on
# The investigator's browser (Playwright MCP). Empty: the global npm install, else npx.
SHAHEEN_BROWSER_MCP=
# Investigations run in parallel by `shaheen up` and `shaheen investigate --queue` (one pi process each;
# give llama-server at least as many slots with -np).
SHAHEEN_INVESTIGATORS=2
# 1 lets the investigator's browser reach localhost and private addresses (local fixture demos only).
SHAHEEN_ALLOW_PRIVATE_FETCH=0

# Storage
SHAHEEN_DB=var/shaheen.db
SHAHEEN_EVIDENCE_DIR=evidence

# Network
SHAHEEN_HTTP_TIMEOUT=10

# Takedown requests: who signs them (generated only for analyst-confirmed cases)
SHAHEEN_REPORTER_NAME=Shaheen analyst
SHAHEEN_REPORTER_EMAIL=

# Watcher: TLDs swept for brand+country storefront names, in order (.com first)
SHAHEEN_STOREFRONT_TLDS=com,shop,store,online,net,co

# Watcher: Google Maps collector. An API key for "Places API (New)" (see the README);
# empty skips the collector. It sends 6 searches per run, one run every SHAHEEN_MAPS_INTERVAL_HOURS.
GOOGLE_MAPS_API_KEY=
SHAHEEN_MAPS_INTERVAL_HOURS=6
# A second key, for the dashboard's live map only: restricted to the "Maps JavaScript API" and to the
# websites http://127.0.0.1:8000/* and http://localhost:8000/* (see the README). It is sent to the browser,
# so never put the Places key here. Empty shows the searches as a log without the map.
GOOGLE_MAPS_BROWSER_KEY=
